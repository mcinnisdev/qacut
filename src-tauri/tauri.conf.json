{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QACut",
  "version": "2.2.0",
  "identifier": "dev.qacut.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/QACut/**",
          "$TEMP/qacut-frames/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQ0IzODUwN0JGRDk2MTIKUldRU2x2MTdVRGpMVHkzb1ZyOXhsOXVLeXEyVWNLZ2RWY004bmNnL2NSMWlyQmdIZGtXMmw0N2YK",
      "endpoints": [
        "https://github.com/mcinnisdev/qacut/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
